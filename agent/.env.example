DATABASE_URL=postgresql://study_mind_app:CHANGE_ME@localhost:5432/study_mind
AGENT_SECRET=REPLACE_WITH_THE_SAME_BACKEND_AGENT_SECRET
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
UPLOAD_DIR=../backend/uploads
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVED_CHUNKS=6
MIN_SIMILARITY=0.35
WORKER_ENABLED=true
OCR_ENABLED=true
# Blank uses project-local .tools/tesseract on Windows, then system PATH.
TESSERACT_CMD=
OCR_LANGUAGE=eng
MAX_OCR_PAGES=100
MAX_MEDIA_SECONDS=1800
